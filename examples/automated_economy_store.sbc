<?xml version="1.0" encoding="utf-8"?>
<Definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <!--
    Mike Dude's GVK Pattern: Automated Economy Store Refresh
    Refreshes store block inventories on a timer, clearing old stock and re-applying store profiles.
    FactionTypes_Economy.sbc GridsForSale is not needed: MES stores sell whatever the store-items file lists.
  -->

  <!--
    1. MES Store Items file (not an SBC): Data\StoreItems\GVK-StoreItems-Rovers.xml
       MES loads it by name from [FileSource:] (ProfileManager.GetStoreItemContainer).

    <StoreItemsContainer xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <StoreItems>
        <StoreItem>
          <StoreItemId>RoverHeavy</StoreItemId>
          <ItemType>Prefab</ItemType>
          <ItemSubtypeId>GVK-Prefab-RoverHeavy</ItemSubtypeId>
          <Offer>
            <CustomPrice>7500000</CustomPrice>
            <MinPriceMultiplier>100</MinPriceMultiplier>
            <MaxPriceMultiplier>100</MaxPriceMultiplier>
          </Offer>
        </StoreItem>
      </StoreItems>
    </StoreItemsContainer>
  -->

  <EntityComponents>
    <!-- 2. MES Store Profile -->
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GVK-StoreProfile-Rovers</SubtypeId>
      </Id>
      <Description>
        [MES Store]
        [FileSource:GVK-StoreItems-Rovers.xml]
        [MinOfferItems:1]
        [MaxOfferItems:1]
        [RequiredOffers:RoverHeavy]
      </Description>
    </EntityComponent>

    <!-- 3. Station Behavior: Passive Trade Station with Store Refresher -->
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GVK-Behavior-TradeStation</SubtypeId>
      </Id>
      <Description>
        [RivalAI Behavior]
        [BehaviorName:Passive]
        [UseRetreatTimer:false]
        [UseNoTargetTimer:false]
        [UsePlayerDistanceTimer:false]
        [Triggers:GVK-Trigger-RefreshStores]
      </Description>
    </EntityComponent>

    <!-- 4. Trigger: Periodic Store Refresh (Every 60 Seconds) -->
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GVK-Trigger-RefreshStores</SubtypeId>
      </Id>
      <Description>
        [MES AI Trigger]
        [UseTrigger:true]
        [Type:Timer]
        [MinCooldownMs:60000]
        [MaxCooldownMs:60001]
        [StartsReady:true]
        [MaxActions:-1]
        [Actions:GVK-Action-RefreshStores]
      </Description>
    </EntityComponent>

    <!-- 5. Action: Clear & Re-apply Store Profiles -->
    <EntityComponent xsi:type="MyObjectBuilder_InventoryComponentDefinition">
      <Id>
        <TypeId>Inventory</TypeId>
        <SubtypeId>GVK-Action-RefreshStores</SubtypeId>
      </Id>
      <Description>
        [MES AI Action]
        [ApplyStoreProfiles:true]
        [ClearStoreContentsFirst:true]
        [StoreBlocks:Store-Rovers]
        [StoreProfiles:GVK-StoreProfile-Rovers]
      </Description>
    </EntityComponent>
  </EntityComponents>

  <!--
    Optional, only if Keen-generated economy stations should also roll this grid
    (FactionTypes_Economy.sbc; the element is PrefabName, not PrefabSubtypeId):

    <GridsForSale>
      <PrefabName>GVK-Prefab-RoverHeavy</PrefabName>
    </GridsForSale>
  -->
</Definitions>